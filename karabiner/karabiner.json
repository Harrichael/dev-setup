              {
                "type": "basic",
                "from": {
                  "key_code": "left_arrow",
                  "modifiers": {
                    "mandatory": [
                      "control"
                    ],
                    "optional": [
                      "shift"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "left_arrow",
                    "modifiers": [
                      "option"
                    ]
                  }
