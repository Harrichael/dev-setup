        "rules": [
          {
            "description": "cmd+fn+N -> cmd+ctrl+N (workspaces), cmd+fn+tab -> F20 (last workspace). AeroSpace cannot bind fn/Globe at all -- it only knows cmd/alt/ctrl/shift -- so fn has to be translated here. The cmd+ctrl and alt+backtick chords stay bound natively in AeroSpace, so navigation survives Karabiner being off. UNTESTED: this machine swaps Command and Globe in System Settings, and which of the two Karabiner observes is not yet verified.",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "1",
                  "modifiers": {
                    "mandatory": [
                      "command",
                      "fn"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "1",
                    "modifiers": [
                      "command",
                      "control"
                    ]
                  }
                ]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "2",
                  "modifiers": {
                    "mandatory": [
                      "command",
                      "fn"
                    ]
                  }
                },
                "to": [
                  {
                    "key_code": "2",
                    "modifiers": [
                      "command",
                      "control"
                    ]
                  }
                ]
              },
              {
