{
  "$schema": "https://schema.linearmouse.app/0.11.4",
  "schemes": [
    {
      "if": {
        "device": {
          "category": "mouse"
        }
      },
      "scrolling": {
        "distance": "70px",
        "reverse": true
      }
    },
    {
      "if": {
        "device": {
          "category": "mouse",
          "productID": "0xc091",
          "vendorID": "0x46d"
        }
      },
      "pointer": {
        "acceleration": 1,
        "hardwareDPI": 8000
      }
    }
  ]
}
